PORT=3000
ADMIN_PASSWORD=change-this-before-deploying
MEMBER_PASSWORD=change-this-member-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-a-long-random-string
DATA_DIR=./data
# JSON array. 只写 urls；TURN 的 username/credential 由服务端用 TURN_SECRET 动态生成，不要写死在这里。
ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
# coturn REST API 临时凭据：必须与 coturn 的 static-auth-secret 一致
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=replace-with-the-same-coturn-static-auth-secret
TURN_TTL_SECONDS=3600
# Cloudflare Tunnel / 反向代理：只有来自这些地址的 CF-Connecting-IP / X-Forwarded-For 才采信（逗号分隔）
# 若隧道跑在 Docker bridge，把网关 IP（如 172.17.0.1）也加进来
TRUST_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# 每 IP 限流：登录 15 分钟内最多 8 次，配对 10 分钟内最多 10 次
LOGIN_LIMIT=8
PAIR_LIMIT=10
